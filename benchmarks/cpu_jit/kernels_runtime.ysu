// Runtime object workloads are appended to kernels.ysu by the worker.
// Each native call creates, grows, scans, then frees its own local object.
// ASCII keeps Y bytes and C# UTF-16 code units numerically identical.

@unsafe
fn string_scan(n: I64, seed: I64) -> I64 {
    let mut text: String = "";
    let mut i: I64 = 0;
    while i < n {
        if ((i + seed) & 7) < 3 {
            String_push(&mut text, 'A');
        } else {
            String_push(&mut text, 'z');
        }
        i = i + 1;
    }
    let mut sum: I64 = 0;
    let mut pass: I64 = 0;
    while pass < 8 {
        i = 0;
        while i < String_len(&text) {
            let mut index: I64 = i;
            if (i & 127) == 0 {
                index = -1;
            } else if (i & 127) == 1 {
                index = String_len(&text);
            }
            let value: I64 = ychar_to_ascii(String_char_at(&text, index));
            sum = sum + value * ((i & 7) + 1);
            i = i + 1;
        }
        pass = pass + 1;
    }
    String_free(&mut text);
    return sum;
}

@unsafe
fn vec_scan_append(n: I64, seed: I64) -> I64 {
    let mut values: Vec = Vec_new(1);
    let mut i: I64 = 0;
    while i < n {
        let mut value: char = 'z';
        if ((i + seed) & 7) < 3 { value = 'A'; }
        Vec_push(&mut values, &value);
        i = i + 1;
    }
    let mut sum: I64 = 0;
    let mut pass: I64 = 0;
    while pass < 8 {
        i = 0;
        while i < Vec_len(&values) {
            let mut index: I64 = i;
            if (i & 127) == 0 {
                index = -1;
            } else if (i & 127) == 1 {
                index = Vec_len(&values);
            }
            let value: I64 = ychar_to_ascii(Vec_get_char(&values, index));
            sum = sum + value * ((i & 7) + 1);
            i = i + 1;
        }
        pass = pass + 1;
    }
    Vec_free(&mut values);
    return sum;
}
