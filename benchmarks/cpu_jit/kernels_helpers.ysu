// Ordinary scalar helpers preserve the direct runtime workloads' algorithms.
// No helper receives or returns a pointer/object, or calls runtime code.
fn scan_helper_upper(index: I64, seed: I64) -> bool {
    return ((index + seed) & 7) < 3;
}

fn scan_helper_weight(index: I64) -> I64 {
    return (index & 7) + 1;
}

@unsafe
fn string_scan_helper(n: I64, seed: I64) -> I64 {
    let mut text: String = "";
    let mut i: I64 = 0;
    while i < n {
        if scan_helper_upper(i, seed) {
            String_push(&mut text, 'A');
        } else {
            String_push(&mut text, 'z');
        }
        i = i + 1;
    }
    let mut sum: I64 = 0;
    let mut pass: I64 = 0;
    while pass < 8 {
        i = 0;
        while i < String_len(&text) {
            let mut index: I64 = i;
            if (i & 127) == 0 {
                index = -1;
            } else if (i & 127) == 1 {
                index = String_len(&text);
            }
            let value: I64 = ychar_to_ascii(String_char_at(&text, index));
            sum = sum + value * scan_helper_weight(i);
            i = i + 1;
        }
        pass = pass + 1;
    }
    String_free(&mut text);
    return sum;
}

@unsafe
fn vec_scan_append_helper(n: I64, seed: I64) -> I64 {
    let mut values: Vec = Vec_new(1);
    let mut i: I64 = 0;
    while i < n {
        let mut value: char = 'z';
        if scan_helper_upper(i, seed) { value = 'A'; }
        Vec_push(&mut values, &value);
        i = i + 1;
    }
    let mut sum: I64 = 0;
    let mut pass: I64 = 0;
    while pass < 8 {
        i = 0;
        while i < Vec_len(&values) {
            let mut index: I64 = i;
            if (i & 127) == 0 {
                index = -1;
            } else if (i & 127) == 1 {
                index = Vec_len(&values);
            }
            let value: I64 = ychar_to_ascii(Vec_get_char(&values, index));
            sum = sum + value * scan_helper_weight(i);
            i = i + 1;
        }
        pass = pass + 1;
    }
    Vec_free(&mut values);
    return sum;
}
