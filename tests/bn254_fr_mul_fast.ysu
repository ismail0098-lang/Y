    m = t0 * 4026531839;
    pr = mul_wide_u32(m, 4026531841) + t0;
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 1138881939) + t1 + c;
    t0 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 2042196113) + t2 + c;
    t1 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 674490440) + t3 + c;
    t2 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 2172737629) + t4 + c;
    t3 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 3092268470) + t5 + c;
    t4 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 3778125865) + t6 + c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 811880050) + t7 + c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = t8;
    pr = sw + c;
    t7 = u64_lo32(pr);
    t8 = t9 + u64_hi32(pr);
    // t is below 2p; subtract p once if it is at least p.
    c = 0;
    sw = t0;
    pr = sw - 4026531841 - c;
    d0 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t1;
    pr = sw - 1138881939 - c;
    d1 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t2;
    pr = sw - 2042196113 - c;
    d2 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t3;
    pr = sw - 674490440 - c;
    d3 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t4;
    pr = sw - 2172737629 - c;
    d4 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t5;
    pr = sw - 3092268470 - c;
    d5 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t6;
    pr = sw - 3778125865 - c;
    d6 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t7;
    pr = sw - 811880050 - c;
    d7 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    mask = 0 - (1 - c);
    nmask = 0 - c;
    r0 = (d0 & mask) | (t0 & nmask);
    r1 = (d1 & mask) | (t1 & nmask);
    r2 = (d2 & mask) | (t2 & nmask);
    r3 = (d3 & mask) | (t3 & nmask);
    r4 = (d4 & mask) | (t4 & nmask);
    r5 = (d5 & mask) | (t5 & nmask);
    r6 = (d6 & mask) | (t6 & nmask);
    r7 = (d7 & mask) | (t7 & nmask);
    block_ptr2d_store_v4(Out, 0, (tid) * 4, 4 * N, 2, 4 * N, r0, r1, r2, r3);
    block_ptr2d_store_v4(Out, 1, (tid) * 4, 4 * N, 2, 4 * N, r4, r5, r6, r7);
}

fn main() {}
