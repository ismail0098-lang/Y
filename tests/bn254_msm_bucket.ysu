        t4 = addc_cc_u32(T14, T14);
        t5 = addc_cc_u32(T15, T15);
        t6 = addc_cc_u32(T16, T16);
        t7 = addc_cc_u32(T17, T17);
        // t is below 2p; subtract p once if it is at least p.
        d0 = sub_cc_u32(t0, 3632069959);
        d1 = subc_cc_u32(t1, 1008765974);
        d2 = subc_cc_u32(t2, 1752287885);
        d3 = subc_cc_u32(t3, 2541841041);
        d4 = subc_cc_u32(t4, 2172737629);
        d5 = subc_cc_u32(t5, 3092268470);
        d6 = subc_cc_u32(t6, 3778125865);
        d7 = subc_cc_u32(t7, 811880050);
        mask = subc_u32(0, 0);
        nmask = mask ^ 4294967295;
        UA0 = (d0 & nmask) | (t0 & mask);
        UA1 = (d1 & nmask) | (t1 & mask);
        UA2 = (d2 & nmask) | (t2 & mask);
        UA3 = (d3 & nmask) | (t3 & mask);
        UA4 = (d4 & nmask) | (t4 & mask);
        UA5 = (d5 & nmask) | (t5 & mask);
        UA6 = (d6 & nmask) | (t6 & mask);
        UA7 = (d7 & nmask) | (t7 & mask);
        t0 = sub_cc_u32(T20, UA0);
        t1 = subc_cc_u32(T21, UA1);
        t2 = subc_cc_u32(T22, UA2);
        t3 = subc_cc_u32(T23, UA3);
        t4 = subc_cc_u32(T24, UA4);
        t5 = subc_cc_u32(T25, UA5);
        t6 = subc_cc_u32(T26, UA6);
        t7 = subc_cc_u32(T27, UA7);
        mask = subc_u32(0, 0);
        // mask is all-ones exactly when the subtraction went negative.
        d0 = 3632069959 & mask;
        d1 = 1008765974 & mask;
        d2 = 1752287885 & mask;
        d3 = 2541841041 & mask;
        d4 = 2172737629 & mask;
        d5 = 3092268470 & mask;
        d6 = 3778125865 & mask;
        d7 = 811880050 & mask;
        nY0 = add_cc_u32(t0, d0);
        nY1 = addc_cc_u32(t1, d1);
        nY2 = addc_cc_u32(t2, d2);
        nY3 = addc_cc_u32(t3, d3);
        nY4 = addc_cc_u32(t4, d4);
        nY5 = addc_cc_u32(t5, d5);
        nY6 = addc_cc_u32(t6, d6);
        nY7 = addc_cc_u32(t7, d7);
        aX0 = nX0;
        aX1 = nX1;
        aX2 = nX2;
        aX3 = nX3;
        aX4 = nX4;
        aX5 = nX5;
        aX6 = nX6;
        aX7 = nX7;
        aY0 = nY0;
        aY1 = nY1;
        aY2 = nY2;
        aY3 = nY3;
        aY4 = nY4;
        aY5 = nY5;
        aY6 = nY6;
        aY7 = nY7;
        aZ0 = nZ0;
        aZ1 = nZ1;
        aZ2 = nZ2;
        aZ3 = nZ3;
        aZ4 = nZ4;
        aZ5 = nZ5;
        aZ6 = nZ6;
        aZ7 = nZ7;
    }
    block_ptr2d_store_v4(RX, 0, (b) * 4, 4 * NB, 2, 4 * NB, aX0, aX1, aX2, aX3);
    block_ptr2d_store_v4(RX, 1, (b) * 4, 4 * NB, 2, 4 * NB, aX4, aX5, aX6, aX7);
    block_ptr2d_store_v4(RY, 0, (b) * 4, 4 * NB, 2, 4 * NB, aY0, aY1, aY2, aY3);
    block_ptr2d_store_v4(RY, 1, (b) * 4, 4 * NB, 2, 4 * NB, aY4, aY5, aY6, aY7);
    block_ptr2d_store_v4(RZ, 0, (b) * 4, 4 * NB, 2, 4 * NB, aZ0, aZ1, aZ2, aZ3);
    block_ptr2d_store_v4(RZ, 1, (b) * 4, 4 * NB, 2, 4 * NB, aZ4, aZ5, aZ6, aZ7);
}

fn main() {}
