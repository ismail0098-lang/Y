        UA1 = (d1 & mask) | (t1 & nmask);
        UA2 = (d2 & mask) | (t2 & nmask);
        UA3 = (d3 & mask) | (t3 & nmask);
        UA4 = (d4 & mask) | (t4 & nmask);
        UA5 = (d5 & mask) | (t5 & nmask);
        UA6 = (d6 & mask) | (t6 & nmask);
        UA7 = (d7 & mask) | (t7 & nmask);
        c = 0;
        sw = T20;
        pr = sw - UA0 - c;
        t0 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T21;
        pr = sw - UA1 - c;
        t1 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T22;
        pr = sw - UA2 - c;
        t2 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T23;
        pr = sw - UA3 - c;
        t3 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T24;
        pr = sw - UA4 - c;
        t4 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T25;
        pr = sw - UA5 - c;
        t5 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T26;
        pr = sw - UA6 - c;
        t6 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        sw = T27;
        pr = sw - UA7 - c;
        t7 = u64_lo32(pr);
        c = u64_hi32(pr) & 1;
        // c is the borrow out: 1 means the true result was negative.
        mask = 0 - c;
        nc = 0;
        sw = t0;
        pr = sw + (3632069959 & mask) + nc;
        nY0 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t1;
        pr = sw + (1008765974 & mask) + nc;
        nY1 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t2;
        pr = sw + (1752287885 & mask) + nc;
        nY2 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t3;
        pr = sw + (2541841041 & mask) + nc;
        nY3 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t4;
        pr = sw + (2172737629 & mask) + nc;
        nY4 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t5;
        pr = sw + (3092268470 & mask) + nc;
        nY5 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t6;
        pr = sw + (3778125865 & mask) + nc;
        nY6 = u64_lo32(pr);
        nc = u64_hi32(pr);
        sw = t7;
        pr = sw + (811880050 & mask) + nc;
        nY7 = u64_lo32(pr);
        nc = u64_hi32(pr);
        aX0 = nX0;
        aX1 = nX1;
        aX2 = nX2;
        aX3 = nX3;
        aX4 = nX4;
        aX5 = nX5;
        aX6 = nX6;
        aX7 = nX7;
        aY0 = nY0;
        aY1 = nY1;
        aY2 = nY2;
        aY3 = nY3;
        aY4 = nY4;
        aY5 = nY5;
        aY6 = nY6;
        aY7 = nY7;
        aZ0 = nZ0;
        aZ1 = nZ1;
        aZ2 = nZ2;
        aZ3 = nZ3;
        aZ4 = nZ4;
        aZ5 = nZ5;
        aZ6 = nZ6;
        aZ7 = nZ7;
    }
    block_ptr2d_store_v4(RX, 0, (b) * 4, 4 * NB, 2, 4 * NB, aX0, aX1, aX2, aX3);
    block_ptr2d_store_v4(RX, 1, (b) * 4, 4 * NB, 2, 4 * NB, aX4, aX5, aX6, aX7);
    block_ptr2d_store_v4(RY, 0, (b) * 4, 4 * NB, 2, 4 * NB, aY0, aY1, aY2, aY3);
    block_ptr2d_store_v4(RY, 1, (b) * 4, 4 * NB, 2, 4 * NB, aY4, aY5, aY6, aY7);
    block_ptr2d_store_v4(RZ, 0, (b) * 4, 4 * NB, 2, 4 * NB, aZ0, aZ1, aZ2, aZ3);
    block_ptr2d_store_v4(RZ, 1, (b) * 4, 4 * NB, 2, 4 * NB, aZ4, aZ5, aZ6, aZ7);
}

fn main() {}
