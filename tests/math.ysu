// tests/math.ysu
// A simple matrix calculation simulation demonstrating Y's safety cage.

@unsafe
fn matrix_init(cell: &mut I32) {
    // Unsafe block: hardware-level initialization, written through a
    // caller-supplied reference.
    //
    // This used to read `let mut mem_ptr: I32 = 0; *mem_ptr = 0;`, treating an
    // integer as an address. Y has no raw pointer type - only `&T` - so that
    // is a type error, and the LLVM backend lowered it to `store i32 0, ptr
    // %_t1` with `%_t1` an i32: invalid IR, emitted under "Compilation
    // Successful!" and exit 0. The front end refuses it by name now.
    *cell = 0;
}

fn calculate_matrix() {
    let size: I32 = 100;
    
    @safe {
        let i: I32 = 0;
        let sum: I32 = 0;
        
        // Loop invariant mathematically proves bounds
        @invariant(i >= 0)
        @divergence(uniform)
        while i < size {
            // Explicit @bounds annotation ensuring zero out-of-bounds violations
            @bounds(0, 100)
            let safe_index: I32 = i;
            
            @divergence(uniform)
            if safe_index < 50 {
                sum = sum + safe_index;
            } else {
                sum = sum + 1;
            }
            
            i = i + 1;
        }
    }
}

fn main() {
    let mut cell: I32 = 1;
    matrix_init(&mut cell);
    calculate_matrix();
}

