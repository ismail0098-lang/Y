.version 8.4
.target sm_89
.address_size 64

.visible .entry rope_64(
    .param .u64 X_0,
    .param .u64 Positions_1,
    .param .u64 Out_2
)
    // [ADVANCED WARP REGISTER ALLOCATOR] Estimated registers per thread: 53
    // [ADVANCED WARP REGISTER ALLOCATOR] Selected register limit: 64 (to maximize SM occupancy)
    // [ADVANCED WARP REGISTER ALLOCATOR] Estimated occupancy: 66.67% (32 active blocks per SM)
.maxnreg 64
{
    .reg .b32 %r<16>;
    .reg .f32 %f<15>;
    .reg .b64 %rd<11>;
    .reg .pred %p<1>;

    ld.param.u64 %rd0, [X_0];
    ld.param.u64 %rd1, [Positions_1];
    ld.param.u64 %rd2, [Out_2];
    // ========================================================
    // [Y FUSED ROPE] head_dim=64 | 1 warp (32 threads) per row | interleaved pairs, base=10000 | 1-pair vectorized blocks
    // ========================================================
    cvta.to.global.u64 %rd3, %rd0;
    cvta.to.global.u64 %rd4, %rd1;
    cvta.to.global.u64 %rd5, %rd2;
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r2, %r0, 64;
    mul.wide.u32 %rd6, %r0, 4;
    add.s64 %rd7, %rd4, %rd6;
    ld.global.u32 %r3, [%rd7];
    cvt.rn.f32.s32 %f0, %r3;
    mul.lo.u32 %r4, %r1, 1;
    add.u32 %r5, %r4, 0;
    mul.lo.u32 %r6, %r5, 2;
    add.u32 %r7, %r2, %r6;
    mul.wide.u32 %rd8, %r7, 2;
    add.s64 %rd9, %rd3, %rd8;
    ld.global.u32 %r8, [%rd9];
    cvt.f32.f16 %f1, %r8;
    shr.b32 %r9, %r8, 16;
    cvt.f32.f16 %f2, %r9;
    add.u32 %r10, %r5, 0;
    cvt.rn.f32.u32 %f3, %r10;
    mul.f32 %f4, %f3, 0fBED49A78;
    ex2.approx.f32 %f5, %f4;
    mul.f32 %f6, %f0, %f5;
    sin.approx.f32 %f7, %f6;
    cos.approx.f32 %f8, %f6;
    mul.f32 %f9, %f1, %f8;
    mul.f32 %f10, %f2, %f7;
    sub.f32 %f11, %f9, %f10;
    mul.f32 %f12, %f1, %f7;
    mul.f32 %f13, %f2, %f8;
    add.f32 %f14, %f12, %f13;
    cvt.rn.f16.f32 %r11, %f11;
    and.b32 %r12, %r11, 0xFFFF;
    cvt.rn.f16.f32 %r13, %f14;
    shl.b32 %r14, %r13, 16;
    or.b32 %r15, %r12, %r14;
    add.s64 %rd10, %rd5, %rd8;
    st.global.u32 [%rd10], %r15;
    // ========================================================
}
