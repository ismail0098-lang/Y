    block_ptr2d_store_v4(RY, 0, (tid) * 4, 4 * N, 2, 4 * N, Y30, Y31, Y32, Y33);
    block_ptr2d_store_v4(RY, 1, (tid) * 4, 4 * N, 2, 4 * N, Y34, Y35, Y36, Y37);
    block_ptr2d_store_v4(RZ, 0, (tid) * 4, 4 * N, 2, 4 * N, Z30, Z31, Z32, Z33);
    block_ptr2d_store_v4(RZ, 1, (tid) * 4, 4 * N, 2, 4 * N, Z34, Z35, Z36, Z37);
}

fn main() {}
