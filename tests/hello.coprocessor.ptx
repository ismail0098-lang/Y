.version 7.8
.target sm_89
.address_size 64

// =======================================================
// Y Compiler - Dual-Accelerator Co-Processing Backend
// Hardware: NVIDIA GeForce RTX 4070 Ti SUPER
// RT Nodes: 0 | Tensor Nodes: 0 | Barriers: 0
// =======================================================


.visible .entry y_coprocessor_fused(
    .param .u64 param_rt_A_ptr,
    .param .u64 param_nns_query_ptr
)
{
    .reg .b32 %r<100>;
    .reg .b32 %rt_r<100>;
    .reg .b32 %qr<100>;
    .reg .f32 %f<100>;
    .reg .f32 %rt_f<100>;
    .reg .f32 %qf<100>;
    .reg .b64 %rd<100>;
    .reg .b64 %rt_rd<100>;
    .reg .b64 %qrd<100>;
    .reg .pred %p<100>;
    .reg .pred %rt_p<100>;
    .reg .pred %qp<100>;
    .reg .b64 rt_A_ptr;
    .reg .b64 nns_query_ptr;

    ld.param.u64 rt_A_ptr, [param_rt_A_ptr];
    ld.param.u64 nns_query_ptr, [param_nns_query_ptr];

    // +----------------------------------------------------------+
    // |  Y DUAL-ACCELERATOR CO-PROCESSING SCHEDULE              |
    // |  RT Core Pipeline:     0 nodes                          |
    // |  Tensor Core Pipeline: 0 nodes                          |
    // |  Sync Barriers:        0                                |
    // |  SMEM Budget:          0 bytes                          |
    // |  Est. Parallel Cycles: 56                             |
    // |  Overlap Savings:      0 cycles                      |
    // +----------------------------------------------------------+


    ret;
}
