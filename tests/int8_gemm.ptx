    mul.lo.u32 %r7, %r6, 128;
    add.u32 %r7, %r7, %r5;
    cvt.u64.u32 %rd6, %r7;
    add.u64 %rd7, %rd3, %rd6;
    mul.lo.u32 %r8, %r1, 8;
    add.u32 %r8, %r8, %r3;
    mul.lo.u32 %r9, %r8, 128;
    add.u32 %r9, %r9, %r5;
    cvt.u64.u32 %rd8, %r9;
    add.u64 %rd9, %rd4, %rd8;
