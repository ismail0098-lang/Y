    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 3778125865) + t6 + c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 811880050) + t7 + c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = t8;
    pr = sw + c;
    t7 = u64_lo32(pr);
    t8 = t9 + u64_hi32(pr);
    // --- CIOS round 7 ---
    c = 0;
    pr = mul_wide_u32(q0, w7) + t0 + c;
    t0 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q1, w7) + t1 + c;
    t1 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q2, w7) + t2 + c;
    t2 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q3, w7) + t3 + c;
    t3 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q4, w7) + t4 + c;
    t4 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q5, w7) + t5 + c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q6, w7) + t6 + c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(q7, w7) + t7 + c;
    t7 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = t8;
    pr = sw + c;
    t8 = u64_lo32(pr);
    t9 = u64_hi32(pr);
    m = t0 * 4026531839;
    pr = mul_wide_u32(m, 4026531841) + t0;
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 1138881939) + t1 + c;
    t0 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 2042196113) + t2 + c;
    t1 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 674490440) + t3 + c;
    t2 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 2172737629) + t4 + c;
    t3 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 3092268470) + t5 + c;
    t4 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 3778125865) + t6 + c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr);
    pr = mul_wide_u32(m, 811880050) + t7 + c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = t8;
    pr = sw + c;
    t7 = u64_lo32(pr);
    t8 = t9 + u64_hi32(pr);
    // t is below 2p; subtract p once if it is at least p.
    c = 0;
    sw = t0;
    pr = sw - 4026531841 - c;
    d0 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t1;
    pr = sw - 1138881939 - c;
    d1 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t2;
    pr = sw - 2042196113 - c;
    d2 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t3;
    pr = sw - 674490440 - c;
    d3 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t4;
    pr = sw - 2172737629 - c;
    d4 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t5;
    pr = sw - 3092268470 - c;
    d5 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t6;
    pr = sw - 3778125865 - c;
    d6 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t7;
    pr = sw - 811880050 - c;
    d7 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    mask = 0 - (1 - c);
    nmask = 0 - c;
    v0 = (d0 & mask) | (t0 & nmask);
    v1 = (d1 & mask) | (t1 & nmask);
    v2 = (d2 & mask) | (t2 & nmask);
    v3 = (d3 & mask) | (t3 & nmask);
    v4 = (d4 & mask) | (t4 & nmask);
    v5 = (d5 & mask) | (t5 & nmask);
    v6 = (d6 & mask) | (t6 & nmask);
    v7 = (d7 & mask) | (t7 & nmask);
    // s = u + v,  e = u - v
    c = 0;
    sw = u0;
    pr = sw + v0 + c;
    t0 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u1;
    pr = sw + v1 + c;
    t1 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u2;
    pr = sw + v2 + c;
    t2 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u3;
    pr = sw + v3 + c;
    t3 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u4;
    pr = sw + v4 + c;
    t4 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u5;
    pr = sw + v5 + c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u6;
    pr = sw + v6 + c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr);
    sw = u7;
    pr = sw + v7 + c;
    t7 = u64_lo32(pr);
    c = u64_hi32(pr);
    c = 0;
    sw = t0;
    pr = sw - 4026531841 - c;
    d0 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t1;
    pr = sw - 1138881939 - c;
    d1 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t2;
    pr = sw - 2042196113 - c;
    d2 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t3;
    pr = sw - 674490440 - c;
    d3 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t4;
    pr = sw - 2172737629 - c;
    d4 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t5;
    pr = sw - 3092268470 - c;
    d5 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t6;
    pr = sw - 3778125865 - c;
    d6 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = t7;
    pr = sw - 811880050 - c;
    d7 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    mask = 0 - (1 - c);
    nmask = 0 - c;
    s0 = (d0 & mask) | (t0 & nmask);
    s1 = (d1 & mask) | (t1 & nmask);
    s2 = (d2 & mask) | (t2 & nmask);
    s3 = (d3 & mask) | (t3 & nmask);
    s4 = (d4 & mask) | (t4 & nmask);
    s5 = (d5 & mask) | (t5 & nmask);
    s6 = (d6 & mask) | (t6 & nmask);
    s7 = (d7 & mask) | (t7 & nmask);
    c = 0;
    sw = u0;
    pr = sw - v0 - c;
    t0 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u1;
    pr = sw - v1 - c;
    t1 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u2;
    pr = sw - v2 - c;
    t2 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u3;
    pr = sw - v3 - c;
    t3 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u4;
    pr = sw - v4 - c;
    t4 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u5;
    pr = sw - v5 - c;
    t5 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u6;
    pr = sw - v6 - c;
    t6 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    sw = u7;
    pr = sw - v7 - c;
    t7 = u64_lo32(pr);
    c = u64_hi32(pr) & 1;
    // c is the borrow out: 1 means the true result was negative.
    mask = 0 - c;
    nc = 0;
    sw = t0;
    pr = sw + (4026531841 & mask) + nc;
    e0 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t1;
    pr = sw + (1138881939 & mask) + nc;
    e1 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t2;
    pr = sw + (2042196113 & mask) + nc;
    e2 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t3;
    pr = sw + (674490440 & mask) + nc;
    e3 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t4;
    pr = sw + (2172737629 & mask) + nc;
    e4 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t5;
    pr = sw + (3092268470 & mask) + nc;
    e5 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t6;
    pr = sw + (3778125865 & mask) + nc;
    e6 = u64_lo32(pr);
    nc = u64_hi32(pr);
    sw = t7;
    pr = sw + (811880050 & mask) + nc;
    e7 = u64_lo32(pr);
    nc = u64_hi32(pr);
    block_ptr2d_store_v4(X, 0, (i0) * 4, 4 * NElem, 2, 4 * NElem, s0, s1, s2, s3);
    block_ptr2d_store_v4(X, 1, (i0) * 4, 4 * NElem, 2, 4 * NElem, s4, s5, s6, s7);
    block_ptr2d_store_v4(X, 0, (i1) * 4, 4 * NElem, 2, 4 * NElem, e0, e1, e2, e3);
    block_ptr2d_store_v4(X, 1, (i1) * 4, 4 * NElem, 2, 4 * NElem, e4, e5, e6, e7);
}

fn main() {}
