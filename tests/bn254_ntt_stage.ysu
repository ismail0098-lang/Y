    t4 = madc_hi_cc_u32(q7, w6, t4);
    t5 = addc_u32(t5, 0);
    m = t6 * 4026531839;
    // t += m * p  (lo pass, then hi pass one limb up)
    t6 = mad_lo_cc_u32(4026531841, m, t6);
    t7 = madc_lo_cc_u32(1138881939, m, t7);
    t8 = madc_lo_cc_u32(2042196113, m, t8);
    t9 = madc_lo_cc_u32(674490440, m, t9);
    t0 = madc_lo_cc_u32(2172737629, m, t0);
    t1 = madc_lo_cc_u32(3092268470, m, t1);
    t2 = madc_lo_cc_u32(3778125865, m, t2);
    t3 = madc_lo_cc_u32(811880050, m, t3);
    t4 = addc_cc_u32(t4, 0);
    t5 = addc_u32(t5, 0);
    t7 = mad_hi_cc_u32(4026531841, m, t7);
    t8 = madc_hi_cc_u32(1138881939, m, t8);
    t9 = madc_hi_cc_u32(2042196113, m, t9);
    t0 = madc_hi_cc_u32(674490440, m, t0);
    t1 = madc_hi_cc_u32(2172737629, m, t1);
    t2 = madc_hi_cc_u32(3092268470, m, t2);
    t3 = madc_hi_cc_u32(3778125865, m, t3);
    t4 = madc_hi_cc_u32(811880050, m, t4);
    t5 = addc_u32(t5, 0);
    t6 = 0;
    // --- CIOS round 7 ---
    // t += a * b_i  (lo pass, then hi pass one limb up)
    t7 = mad_lo_cc_u32(q0, w7, t7);
    t8 = madc_lo_cc_u32(q1, w7, t8);
    t9 = madc_lo_cc_u32(q2, w7, t9);
    t0 = madc_lo_cc_u32(q3, w7, t0);
    t1 = madc_lo_cc_u32(q4, w7, t1);
    t2 = madc_lo_cc_u32(q5, w7, t2);
    t3 = madc_lo_cc_u32(q6, w7, t3);
    t4 = madc_lo_cc_u32(q7, w7, t4);
    t5 = addc_cc_u32(t5, 0);
    t6 = addc_u32(t6, 0);
    t8 = mad_hi_cc_u32(q0, w7, t8);
    t9 = madc_hi_cc_u32(q1, w7, t9);
    t0 = madc_hi_cc_u32(q2, w7, t0);
    t1 = madc_hi_cc_u32(q3, w7, t1);
    t2 = madc_hi_cc_u32(q4, w7, t2);
    t3 = madc_hi_cc_u32(q5, w7, t3);
    t4 = madc_hi_cc_u32(q6, w7, t4);
    t5 = madc_hi_cc_u32(q7, w7, t5);
    t6 = addc_u32(t6, 0);
    m = t7 * 4026531839;
    // t += m * p  (lo pass, then hi pass one limb up)
    t7 = mad_lo_cc_u32(4026531841, m, t7);
    t8 = madc_lo_cc_u32(1138881939, m, t8);
    t9 = madc_lo_cc_u32(2042196113, m, t9);
    t0 = madc_lo_cc_u32(674490440, m, t0);
    t1 = madc_lo_cc_u32(2172737629, m, t1);
    t2 = madc_lo_cc_u32(3092268470, m, t2);
    t3 = madc_lo_cc_u32(3778125865, m, t3);
    t4 = madc_lo_cc_u32(811880050, m, t4);
    t5 = addc_cc_u32(t5, 0);
    t6 = addc_u32(t6, 0);
    t8 = mad_hi_cc_u32(4026531841, m, t8);
    t9 = madc_hi_cc_u32(1138881939, m, t9);
    t0 = madc_hi_cc_u32(2042196113, m, t0);
    t1 = madc_hi_cc_u32(674490440, m, t1);
    t2 = madc_hi_cc_u32(2172737629, m, t2);
    t3 = madc_hi_cc_u32(3092268470, m, t3);
    t4 = madc_hi_cc_u32(3778125865, m, t4);
    t5 = madc_hi_cc_u32(811880050, m, t5);
    t6 = addc_u32(t6, 0);
    t7 = 0;
    // t is below 2p; subtract p once if it is at least p.
    d0 = sub_cc_u32(t8, 4026531841);
    d1 = subc_cc_u32(t9, 1138881939);
    d2 = subc_cc_u32(t0, 2042196113);
    d3 = subc_cc_u32(t1, 674490440);
    d4 = subc_cc_u32(t2, 2172737629);
    d5 = subc_cc_u32(t3, 3092268470);
    d6 = subc_cc_u32(t4, 3778125865);
    d7 = subc_cc_u32(t5, 811880050);
    mask = subc_u32(0, 0);
    nmask = mask ^ 4294967295;
    v0 = (d0 & nmask) | (t8 & mask);
    v1 = (d1 & nmask) | (t9 & mask);
    v2 = (d2 & nmask) | (t0 & mask);
    v3 = (d3 & nmask) | (t1 & mask);
    v4 = (d4 & nmask) | (t2 & mask);
    v5 = (d5 & nmask) | (t3 & mask);
    v6 = (d6 & nmask) | (t4 & mask);
    v7 = (d7 & nmask) | (t5 & mask);
    // s = u + v,  e = u - v
    t0 = add_cc_u32(u0, v0);
    t1 = addc_cc_u32(u1, v1);
    t2 = addc_cc_u32(u2, v2);
    t3 = addc_cc_u32(u3, v3);
    t4 = addc_cc_u32(u4, v4);
    t5 = addc_cc_u32(u5, v5);
    t6 = addc_cc_u32(u6, v6);
    t7 = addc_cc_u32(u7, v7);
    // t is below 2p; subtract p once if it is at least p.
    d0 = sub_cc_u32(t0, 4026531841);
    d1 = subc_cc_u32(t1, 1138881939);
    d2 = subc_cc_u32(t2, 2042196113);
    d3 = subc_cc_u32(t3, 674490440);
    d4 = subc_cc_u32(t4, 2172737629);
    d5 = subc_cc_u32(t5, 3092268470);
    d6 = subc_cc_u32(t6, 3778125865);
    d7 = subc_cc_u32(t7, 811880050);
    mask = subc_u32(0, 0);
    nmask = mask ^ 4294967295;
    s0 = (d0 & nmask) | (t0 & mask);
    s1 = (d1 & nmask) | (t1 & mask);
    s2 = (d2 & nmask) | (t2 & mask);
    s3 = (d3 & nmask) | (t3 & mask);
    s4 = (d4 & nmask) | (t4 & mask);
    s5 = (d5 & nmask) | (t5 & mask);
    s6 = (d6 & nmask) | (t6 & mask);
    s7 = (d7 & nmask) | (t7 & mask);
    t0 = sub_cc_u32(u0, v0);
    t1 = subc_cc_u32(u1, v1);
    t2 = subc_cc_u32(u2, v2);
    t3 = subc_cc_u32(u3, v3);
    t4 = subc_cc_u32(u4, v4);
    t5 = subc_cc_u32(u5, v5);
    t6 = subc_cc_u32(u6, v6);
    t7 = subc_cc_u32(u7, v7);
    mask = subc_u32(0, 0);
    // mask is all-ones exactly when the subtraction went negative.
    d0 = 4026531841 & mask;
    d1 = 1138881939 & mask;
    d2 = 2042196113 & mask;
    d3 = 674490440 & mask;
    d4 = 2172737629 & mask;
    d5 = 3092268470 & mask;
    d6 = 3778125865 & mask;
    d7 = 811880050 & mask;
    e0 = add_cc_u32(t0, d0);
    e1 = addc_cc_u32(t1, d1);
    e2 = addc_cc_u32(t2, d2);
    e3 = addc_cc_u32(t3, d3);
    e4 = addc_cc_u32(t4, d4);
    e5 = addc_cc_u32(t5, d5);
    e6 = addc_cc_u32(t6, d6);
    e7 = addc_cc_u32(t7, d7);
    block_ptr2d_store_v4(X, 0, (i0) * 4, 4 * NElem, 2, 4 * NElem, s0, s1, s2, s3);
    block_ptr2d_store_v4(X, 1, (i0) * 4, 4 * NElem, 2, 4 * NElem, s4, s5, s6, s7);
    block_ptr2d_store_v4(X, 0, (i1) * 4, 4 * NElem, 2, 4 * NElem, e0, e1, e2, e3);
    block_ptr2d_store_v4(X, 1, (i1) * 4, 4 * NElem, 2, 4 * NElem, e4, e5, e6, e7);
}

fn main() {}
