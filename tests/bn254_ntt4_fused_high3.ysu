    t8 = madc_lo_cc_u32(2042196113, m, t8);
    t9 = madc_lo_cc_u32(674490440, m, t9);
    t0 = madc_lo_cc_u32(2172737629, m, t0);
    t1 = madc_lo_cc_u32(3092268470, m, t1);
    t2 = madc_lo_cc_u32(3778125865, m, t2);
    t3 = madc_lo_cc_u32(811880050, m, t3);
    t4 = addc_cc_u32(t4, 0);
    t5 = addc_u32(t5, 0);
    t7 = mad_hi_cc_u32(4026531841, m, t7);
    t8 = madc_hi_cc_u32(1138881939, m, t8);
    t9 = madc_hi_cc_u32(2042196113, m, t9);
    t0 = madc_hi_cc_u32(674490440, m, t0);
    t1 = madc_hi_cc_u32(2172737629, m, t1);
    t2 = madc_hi_cc_u32(3092268470, m, t2);
    t3 = madc_hi_cc_u32(3778125865, m, t3);
    t4 = madc_hi_cc_u32(811880050, m, t4);
    t5 = addc_u32(t5, 0);
    t6 = 0;
    // --- CIOS round 7 ---
    // t += a * b_i  (lo pass, then hi pass one limb up)
    t7 = mad_lo_cc_u32(A0, iw7, t7);
    t8 = madc_lo_cc_u32(A1, iw7, t8);
    t9 = madc_lo_cc_u32(A2, iw7, t9);
    t0 = madc_lo_cc_u32(A3, iw7, t0);
    t1 = madc_lo_cc_u32(A4, iw7, t1);
    t2 = madc_lo_cc_u32(A5, iw7, t2);
    t3 = madc_lo_cc_u32(A6, iw7, t3);
    t4 = madc_lo_cc_u32(A7, iw7, t4);
    t5 = addc_cc_u32(t5, 0);
    t6 = addc_u32(t6, 0);
    t8 = mad_hi_cc_u32(A0, iw7, t8);
    t9 = madc_hi_cc_u32(A1, iw7, t9);
    t0 = madc_hi_cc_u32(A2, iw7, t0);
    t1 = madc_hi_cc_u32(A3, iw7, t1);
    t2 = madc_hi_cc_u32(A4, iw7, t2);
    t3 = madc_hi_cc_u32(A5, iw7, t3);
    t4 = madc_hi_cc_u32(A6, iw7, t4);
    t5 = madc_hi_cc_u32(A7, iw7, t5);
    t6 = addc_u32(t6, 0);
    m = t7 * 4026531839;
    // t += m * p  (lo pass, then hi pass one limb up)
    t7 = mad_lo_cc_u32(4026531841, m, t7);
    t8 = madc_lo_cc_u32(1138881939, m, t8);
    t9 = madc_lo_cc_u32(2042196113, m, t9);
    t0 = madc_lo_cc_u32(674490440, m, t0);
    t1 = madc_lo_cc_u32(2172737629, m, t1);
    t2 = madc_lo_cc_u32(3092268470, m, t2);
    t3 = madc_lo_cc_u32(3778125865, m, t3);
    t4 = madc_lo_cc_u32(811880050, m, t4);
    t5 = addc_cc_u32(t5, 0);
    t6 = addc_u32(t6, 0);
    t8 = mad_hi_cc_u32(4026531841, m, t8);
    t9 = madc_hi_cc_u32(1138881939, m, t9);
    t0 = madc_hi_cc_u32(2042196113, m, t0);
    t1 = madc_hi_cc_u32(674490440, m, t1);
    t2 = madc_hi_cc_u32(2172737629, m, t2);
    t3 = madc_hi_cc_u32(3092268470, m, t3);
    t4 = madc_hi_cc_u32(3778125865, m, t4);
    t5 = madc_hi_cc_u32(811880050, m, t5);
    t6 = addc_u32(t6, 0);
    t7 = 0;
    // t is below 2p; subtract p once if it is at least p.
    d0 = sub_cc_u32(t8, 4026531841);
    d1 = subc_cc_u32(t9, 1138881939);
    d2 = subc_cc_u32(t0, 2042196113);
    d3 = subc_cc_u32(t1, 674490440);
    d4 = subc_cc_u32(t2, 2172737629);
    d5 = subc_cc_u32(t3, 3092268470);
    d6 = subc_cc_u32(t4, 3778125865);
    d7 = subc_cc_u32(t5, 811880050);
    mask = subc_u32(0, 0);
    nmask = mask ^ 4294967295;
    H0 = (d0 & nmask) | (t8 & mask);
    H1 = (d1 & nmask) | (t9 & mask);
    H2 = (d2 & nmask) | (t0 & mask);
    H3 = (d3 & nmask) | (t1 & mask);
    H4 = (d4 & nmask) | (t2 & mask);
    H5 = (d5 & nmask) | (t3 & mask);
    H6 = (d6 & nmask) | (t4 & mask);
    H7 = (d7 & nmask) | (t5 & mask);
    // X0 = t0 + t2, X1 = t1 + t3, X2 = t0 - t2, X3 = t1 - t3
    t0 = add_cc_u32(E0, G0);
    t1 = addc_cc_u32(E1, G1);
    t2 = addc_cc_u32(E2, G2);
    t3 = addc_cc_u32(E3, G3);
    t4 = addc_cc_u32(E4, G4);
    t5 = addc_cc_u32(E5, G5);
    t6 = addc_cc_u32(E6, G6);
    t7 = addc_cc_u32(E7, G7);
    // t is below 2p; subtract p once if it is at least p.
    d0 = sub_cc_u32(t0, 4026531841);
    d1 = subc_cc_u32(t1, 1138881939);
    d2 = subc_cc_u32(t2, 2042196113);
    d3 = subc_cc_u32(t3, 674490440);
    d4 = subc_cc_u32(t4, 2172737629);
    d5 = subc_cc_u32(t5, 3092268470);
    d6 = subc_cc_u32(t6, 3778125865);
    d7 = subc_cc_u32(t7, 811880050);
    mask = subc_u32(0, 0);
    nmask = mask ^ 4294967295;
    B0 = (d0 & nmask) | (t0 & mask);
    B1 = (d1 & nmask) | (t1 & mask);
    B2 = (d2 & nmask) | (t2 & mask);
    B3 = (d3 & nmask) | (t3 & mask);
    B4 = (d4 & nmask) | (t4 & mask);
    B5 = (d5 & nmask) | (t5 & mask);
    B6 = (d6 & nmask) | (t6 & mask);
    B7 = (d7 & nmask) | (t7 & mask);
    t0 = add_cc_u32(F0, H0);
    t1 = addc_cc_u32(F1, H1);
    t2 = addc_cc_u32(F2, H2);
    t3 = addc_cc_u32(F3, H3);
    t4 = addc_cc_u32(F4, H4);
    t5 = addc_cc_u32(F5, H5);
    t6 = addc_cc_u32(F6, H6);
    t7 = addc_cc_u32(F7, H7);
    // t is below 2p; subtract p once if it is at least p.
    d0 = sub_cc_u32(t0, 4026531841);
    d1 = subc_cc_u32(t1, 1138881939);
    d2 = subc_cc_u32(t2, 2042196113);
    d3 = subc_cc_u32(t3, 674490440);
    d4 = subc_cc_u32(t4, 2172737629);
    d5 = subc_cc_u32(t5, 3092268470);
    d6 = subc_cc_u32(t6, 3778125865);
    d7 = subc_cc_u32(t7, 811880050);
    mask = subc_u32(0, 0);
    nmask = mask ^ 4294967295;
    C0 = (d0 & nmask) | (t0 & mask);
    C1 = (d1 & nmask) | (t1 & mask);
    C2 = (d2 & nmask) | (t2 & mask);
    C3 = (d3 & nmask) | (t3 & mask);
    C4 = (d4 & nmask) | (t4 & mask);
    C5 = (d5 & nmask) | (t5 & mask);
    C6 = (d6 & nmask) | (t6 & mask);
    C7 = (d7 & nmask) | (t7 & mask);
    t0 = sub_cc_u32(E0, G0);
    t1 = subc_cc_u32(E1, G1);
    t2 = subc_cc_u32(E2, G2);
    t3 = subc_cc_u32(E3, G3);
    t4 = subc_cc_u32(E4, G4);
    t5 = subc_cc_u32(E5, G5);
    t6 = subc_cc_u32(E6, G6);
    t7 = subc_cc_u32(E7, G7);
    mask = subc_u32(0, 0);
    // mask is all-ones exactly when the subtraction went negative.
    d0 = 4026531841 & mask;
    d1 = 1138881939 & mask;
    d2 = 2042196113 & mask;
    d3 = 674490440 & mask;
    d4 = 2172737629 & mask;
    d5 = 3092268470 & mask;
    d6 = 3778125865 & mask;
    d7 = 811880050 & mask;
    D0 = add_cc_u32(t0, d0);
    D1 = addc_cc_u32(t1, d1);
    D2 = addc_cc_u32(t2, d2);
    D3 = addc_cc_u32(t3, d3);
    D4 = addc_cc_u32(t4, d4);
    D5 = addc_cc_u32(t5, d5);
    D6 = addc_cc_u32(t6, d6);
    D7 = addc_cc_u32(t7, d7);
    t0 = sub_cc_u32(F0, H0);
    t1 = subc_cc_u32(F1, H1);
    t2 = subc_cc_u32(F2, H2);
    t3 = subc_cc_u32(F3, H3);
    t4 = subc_cc_u32(F4, H4);
    t5 = subc_cc_u32(F5, H5);
    t6 = subc_cc_u32(F6, H6);
    t7 = subc_cc_u32(F7, H7);
    mask = subc_u32(0, 0);
    // mask is all-ones exactly when the subtraction went negative.
    d0 = 4026531841 & mask;
    d1 = 1138881939 & mask;
    d2 = 2042196113 & mask;
    d3 = 674490440 & mask;
    d4 = 2172737629 & mask;
    d5 = 3092268470 & mask;
    d6 = 3778125865 & mask;
    d7 = 811880050 & mask;
    E0 = add_cc_u32(t0, d0);
    E1 = addc_cc_u32(t1, d1);
    E2 = addc_cc_u32(t2, d2);
    E3 = addc_cc_u32(t3, d3);
    E4 = addc_cc_u32(t4, d4);
    E5 = addc_cc_u32(t5, d5);
    E6 = addc_cc_u32(t6, d6);
    E7 = addc_cc_u32(t7, d7);
    let gj0_2: I32 = j0_2 + 0;
    block_ptr2d_store_v4(X, 0, (sbase + u + gj0_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, B0, B1, B2, B3);
    block_ptr2d_store_v4(X, 1, (sbase + u + gj0_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, B4, B5, B6, B7);
    let gj1_2: I32 = j0_2 + 16;
    block_ptr2d_store_v4(X, 0, (sbase + u + gj1_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, C0, C1, C2, C3);
    block_ptr2d_store_v4(X, 1, (sbase + u + gj1_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, C4, C5, C6, C7);
    let gj2_2: I32 = j0_2 + 32;
    block_ptr2d_store_v4(X, 0, (sbase + u + gj2_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, D0, D1, D2, D3);
    block_ptr2d_store_v4(X, 1, (sbase + u + gj2_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, D4, D5, D6, D7);
    let gj3_2: I32 = j0_2 + 48;
    block_ptr2d_store_v4(X, 0, (sbase + u + gj3_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, E0, E1, E2, E3);
    block_ptr2d_store_v4(X, 1, (sbase + u + gj3_2 * Q0) * 4, 4 * NElem, 2, 4 * NElem, E4, E5, E6, E7);
}

