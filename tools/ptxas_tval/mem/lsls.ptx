// The GENUINE ptxas output for las_ptx.ptx, and a CORRECT translation:
// ptxas kept the store above the load it could not prove unaliased.  It is
// REFUSED, and that is the price of the refusal stated as a standing row: the
// memory model cannot represent a read-back, so it cannot tell this program from
// las_ptx, and before memorder.py it VALIDATED both.  A store-ordered memory
// model is what turns this row VALIDATED while las_ptx stays refused.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd2, [P2];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd22, %rd2, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    st.global.f32 [%rd22], %f0;
    ld.global.f32 %f1, [%rd21];
    st.global.f32 [%rd23], %f1;
}
