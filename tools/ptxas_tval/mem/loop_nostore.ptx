// loop_swap with every store removed from BOTH sides.  loopval VALIDATED it,
// "0 stores": tval.run has refused a kernel that stores nothing for a long time,
// and this validator had no such check.  Nothing to prove is not a proof.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r5, %tid.x;
    mov.u32 %r1, 0;
    mov.u32 %r2, 7;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    xor.b32 %r3, %r2, %r1;
    add.u32 %r2, %r3, %r5;
    add.u32 %r1, %r1, 1;
    bra $LOOP_START_0;
    $LOOP_END_1:
}
