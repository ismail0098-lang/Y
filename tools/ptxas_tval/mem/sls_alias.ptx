// A CORRECT translation that pins the ORDER in which two stores to ONE address
// are paired.  PTX: load a0, store a2, load a3, store a2 again.  The load reads
// P3, which the host may alias with P2, so ptxas can neither forward the first
// store into it nor delete the first store as dead -- the genuine ptxas output
// keeps two stores at one address with a possible read-back between them.
// memorder.pair_by_address pairs an equal-address group in occurrence order;
// paired in REVERSE, the second store's value is compared with the first's and a
// correct translation goes UNPROVED.  No other row has two stores at one
// address, so without this one that order was pinned by nothing.
// Standing result: VALIDATED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd2, [P2];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd22, %rd2, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.u32 %r1, [%rd20];
    st.global.u32 [%rd22], %r1;
    ld.global.u32 %r2, [%rd23];
    add.u32 %r3, %r2, %r1;
    st.global.u32 [%rd22], %r3;
}
