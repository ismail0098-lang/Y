// A loop that ACCUMULATES INTO MEMORY: b[0] += a[i].  Each iteration loads the
// value the previous iteration stored, so this is a read-back ACROSS
// iterations.  loopval refuses it (each region runs in a fresh state); nestval
// validates it, because every iteration starts from one memory array shared by
// both sides and the stores of one iteration are compared before the next.
// nest_accum.sass is ptxas's genuine -O1 output.  Standing result: VALIDATED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r1, 0;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    cvt.u64.u32 %rd4, %r1;
    shl.b64 %rd3, %rd4, 2;
    add.u64 %rd5, %rd0, %rd3;
    ld.global.u32 %r2, [%rd5];
    ld.global.u32 %r3, [%rd1];
    add.u32 %r4, %r3, %r2;
    st.global.u32 [%rd1], %r4;
    add.u32 %r1, %r1, 1;
    bra $LOOP_START_0;
    $LOOP_END_1:
}
