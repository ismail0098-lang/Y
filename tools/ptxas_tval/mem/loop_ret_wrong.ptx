// A loop whose BODY returns early (`@%p1 ret` once i >= 3), with the SASS's
// `@P0 EXIT` DELETED -- a wrong translation that keeps iterating.  Only the PTX
// side can now end early, so this is the row that reaches loopval's PTX-region
// can-end check alone: for the genuine translation the SASS side's EXIT is
// refused first.  On HEAD the genuine translation VALIDATED -- right by accident,
// both sides' exits ignored alike -- and this wrong one VALIDATED as well.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r5, %tid.x;
    mov.u32 %r1, 0;
    mov.u32 %r2, 7;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    xor.b32 %r3, %r2, %r1;
    add.u32 %r2, %r3, %r5;
    add.u32 %r1, %r1, 1;
    setp.ge.u32 %p1, %r1, 3;
    @%p1 ret;
    bra $LOOP_START_0;
    $LOOP_END_1:
    st.global.u32 [%rd0], %r2;
    st.global.u32 [%rd1], %r1;
}
