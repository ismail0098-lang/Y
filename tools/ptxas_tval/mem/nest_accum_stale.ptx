// The WRONG twin of nest_accum: the SASS loads b[0] ONCE, before the loop, and
// adds a[i] to that stale value every iteration, so it forgets every previous
// store.  The first iteration agrees with the PTX; only a model that carries
// memory from one iteration to the next can see the difference.  A validator
// reading the loop-entry memory in every iteration VALIDATES this.
// Standing result: UNPROVED at `iteration store 0 value: sat`.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r1, 0;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    cvt.u64.u32 %rd4, %r1;
    shl.b64 %rd3, %rd4, 2;
    add.u64 %rd5, %rd0, %rd3;
    ld.global.u32 %r2, [%rd5];
    ld.global.u32 %r3, [%rd1];
    add.u32 %r4, %r3, %r2;
    st.global.u32 [%rd1], %r4;
    add.u32 %r1, %r1, 1;
    bra $LOOP_START_0;
    $LOOP_END_1:
}
