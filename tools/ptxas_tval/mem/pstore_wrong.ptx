// A WRONG TRANSLATION loopval VALIDATED before this change: pstore with the
// prologue store's VALUE register swapped (R4 -> R5), so the SASS writes 7 where
// the PTX writes the thread index.  The obligations never mentioned that store.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r5, %tid.x;
    st.global.u32 [%rd1], %r5;
    mov.u32 %r1, 0;
    mov.u32 %r2, 7;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    xor.b32 %r3, %r2, %r1;
    add.u32 %r2, %r3, %r5;
    add.u32 %r1, %r1, 1;
    bra $LOOP_START_0;
    $LOOP_END_1:
    st.global.u32 [%rd0], %r2;
}
