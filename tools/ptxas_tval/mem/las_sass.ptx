// A WRONG TRANSLATION the validator VALIDATED before memorder.py existed.
// PTX: load a0, load a1, store a2, store a3.  The SASS is ptxas's own output with
// the FIRST store moved above the SECOND load, so on the machine that load reads
// the store back whenever a1 == a2 -- the host may pass aliasing buffers.  The
// model read both loads from the initial array and saw two identical programs.
// Hand-edited SASS: the SASS side has the read-back, the PTX side does not, so
// this row pins that the check is made on the SASS side.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd2, [P2];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd22, %rd2, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    ld.global.f32 %f1, [%rd21];
    st.global.f32 [%rd22], %f0;
    st.global.f32 [%rd23], %f1;
}
