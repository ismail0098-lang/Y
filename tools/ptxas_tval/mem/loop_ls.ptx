// The GENUINE ptxas output for a loop that loads a[i] and stores b[i] in its
// body -- a CORRECT translation.  REFUSED on the read-back check, and only
// because loopval runs the body TWICE: one iteration is L then S, two are
// L S L S, and the second load could read the first store when b aliases a
// shifted by one element.  Before this change it was refused as "store inside
// the loop body"; that refusal comes second now, because a read-back would
// survive lifting it.
// Standing result: REFUSED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .b32 N_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u32 %r0, [N_2];
    mov.u32 %r1, 0;
    $LOOP_START_0:
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra $LOOP_END_1;
    cvt.u64.u32 %rd4, %r1;
    shl.b64 %rd3, %rd4, 2;
    add.u64 %rd5, %rd0, %rd3;
    add.u64 %rd6, %rd1, %rd3;
    ld.global.u32 %r2, [%rd5];
    st.global.u32 [%rd6], %r2;
    add.u32 %r1, %r1, 1;
    bra $LOOP_START_0;
    $LOOP_END_1:
}
