// A `neg.f32` that CANNOT be folded, because its result goes straight to a
// store.  ptxas lowers it to `FADD Rd, -Rx, -RZ`, which is ARITHMETIC.
//
// UNPROVED, and that is the correct answer rather than a modelling gap: on the
// device that lowering returns the canonical quiet NaN 0x7fffffff for every NaN
// input, discarding the payload AND the sign, where a sign flip preserves both.
// 8 of 32 vectors differ; `fpsem_abi.py` measures it.  A corpus containing
// nothing the validator refutes cannot be told apart from a validator that
// always says VALIDATED, so this row is a standing result in its own direction.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd3, [P3];
    ld.param.u64 %rd4, [P4];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    add.u64 %rd24, %rd4, %rd11;
    ld.global.f32 %f0, [%rd20];
    neg.f32 %f1, %f0;
    st.global.f32 [%rd23], %f1;
    st.global.f32 [%rd24], %f0;
}
