// A `neg.f32` FOLDED into an FFMA operand modifier -- the shape every one of
// the 23 `neg.f32` in the committed corpus takes, and exactly what
// `emit_rope_kernel` emits for `x0*cos - x1*sin`.
//   PTX   mul.f32 ; neg.f32 ; fma.rn.f32
//   SASS  FMUL R9, R4, R7 ; FFMA R11, R2, R2, -R9
// VALIDATED: both sides build FFMA(a, a, FNEG(FMUL(b,c))).
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd2, [P2];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd22, %rd2, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    ld.global.f32 %f1, [%rd21];
    ld.global.f32 %f2, [%rd22];
    mul.f32 %f3, %f1, %f2;
    neg.f32 %f4, %f3;
    fma.rn.f32 %f5, %f0, %f0, %f4;
    st.global.f32 [%rd23], %f5;
}
