// A plain float subtract.  ptxas lowers `sub.f32 d, a, b` to `FADD Rd, Ra, -Rb`
// -- a NEGATED FLOAT SOURCE, which the integer operand reader used to read as a
// two's-complement negation of the bit pattern.  That was a guess rather than a
// refusal and it made this kernel report a spurious `UNPROVED store 0: sat`.
// VALIDATED now, via FNEG plus the FSUB(a,b) == FADD(a, FNEG(b)) identification.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    ld.global.f32 %f1, [%rd21];
    sub.f32 %f2, %f0, %f1;
    st.global.f32 [%rd23], %f2;
}
