//
// One u32 division stored TWICE.  At d == 0 the PTX ISA leaves the quotient
// unspecified, but it is ONE value: a translation storing two different values
// there is wrong.  udiv/twice_split.sass is ptxas's genuine output with the
// second store fed the pre-select quotient, so the two stores differ ONLY at
// d == 0 -- the case tval.py's consistency check exists for.
//
.version 7.8
.target sm_89
.address_size 64

.visible .entry twice(
    .param .u64 pA, .param .u64 pB, .param .u64 pO)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd0, [pA];
    ld.param.u64 %rd1, [pB];
    ld.param.u64 %rd2, [pO];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd9, %r0;
    shl.b64 %rd3, %rd9, 2;
    add.u64 %rd4, %rd0, %rd3;
    add.u64 %rd5, %rd1, %rd3;
    ld.global.u32 %r1, [%rd4];
    ld.global.u32 %r2, [%rd5];
    div.u32 %r3, %r1, %r2;
    shl.b64 %rd6, %rd9, 3;
    add.u64 %rd7, %rd2, %rd6;
    st.global.u32 [%rd7], %r3;
    add.u64 %rd8, %rd7, 4;
    st.global.u32 [%rd8], %r3;
    ret;
}
