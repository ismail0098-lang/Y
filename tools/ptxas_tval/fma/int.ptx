.version 7.8
.target sm_89
.address_size 64
.visible .entry k(.param .u64 A, .param .u64 B, .param .u64 C, .param .u64 O)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<16>;
    ld.param.u64 %rd0, [A];
    ld.param.u64 %rd1, [B];
    ld.param.u64 %rd2, [C];
    ld.param.u64 %rd3, [O];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd4, %r0;
    shl.b64 %rd5, %rd4, 2;
    add.u64 %rd6, %rd0, %rd5;
    add.u64 %rd7, %rd1, %rd5;
    add.u64 %rd8, %rd2, %rd5;
    add.u64 %rd9, %rd3, %rd5;
    ld.global.u32 %r1, [%rd6];
    ld.global.u32 %r2, [%rd7];
    ld.global.u32 %r3, [%rd8];
    mul.lo.s32 %r4, %r1, %r2;
    add.s32 %r5, %r3, %r4;
    st.global.u32 [%rd9], %r5;
    ret;
}
