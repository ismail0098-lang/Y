// `max.f32` on two runtime values -- the softmax running-max shape, and the
// control for `relu`: it has no literal operand for ptxas to fold into RZ, so
// it pins that the model is a binary function rather than a special case of
// the ReLU form.
//   PTX   max.f32 %f5, %f0, %f1
//   SASS  FMNMX R9, R2, R5, !PT
// VALIDATED.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    ld.global.f32 %f1, [%rd21];
    max.f32 %f5, %f0, %f1;
    st.global.f32 [%rd23], %f5;
}
