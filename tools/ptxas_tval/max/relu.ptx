// The SHIPPED ReLU epilogue's shape.  `emit_gemm_bias_relu_epilogue` writes
// `max.f32 r, r, 0f00000000`; ptxas lowers it to `FMNMX d, RZ, x, !PT` -- with
// the OPERANDS SWAPPED, which is why this needs FMAX commutativity and why
// that had to be measured (see fpmode.IDENTIFICATIONS).
//
// The operand swap is the shipped artifact's, not this fixture's: in
// tests/gemm_f16_bias_relu_512.ptx the emitter writes
//   max.f32 %f24, %f24, 0f00000000;
// and its committed SASS carries
//   FMNMX R20, RZ, R14, !PT ;
// -- the literal in the FIRST slot, exactly as below.  The emitter aliases the
// destination onto the source and this fixture does not; that difference does
// not reach the lowering, which was checked rather than assumed.
//   PTX   max.f32 %f5, %f0, 0f00000000
//   SASS  FMNMX R7, RZ, R2, !PT
// VALIDATED: both sides build FMAX(+0.0, x) after canonicalisation.
//
// This validates the shipped LOWERING, not the shipped kernel: the six
// gemm_f16_bias_relu_* around it are 11 PTX and 14 SASS opcodes away.
.version 7.8
.target sm_89
.address_size 64
.visible .entry probe(
    .param .u64 P0, .param .u64 P1, .param .u64 P2,
    .param .u64 P3, .param .u64 P4, .param .u64 P5
)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<32>;
    ld.param.u64 %rd0, [P0];
    ld.param.u64 %rd1, [P1];
    ld.param.u64 %rd3, [P3];
    mov.u32 %r0, %tid.x;
    cvt.u64.u32 %rd10, %r0;
    shl.b64 %rd11, %rd10, 2;
    add.u64 %rd20, %rd0, %rd11;
    add.u64 %rd21, %rd1, %rd11;
    add.u64 %rd23, %rd3, %rd11;
    ld.global.f32 %f0, [%rd20];
    max.f32 %f5, %f0, 0f00000000;
    st.global.f32 [%rd23], %f5;
}
